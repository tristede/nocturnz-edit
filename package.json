{
  "name": "nocturnz-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "setup:engine": "python3 scripts/install-engine.py",
    "setup:modules": "python3 scripts/install-modules.py",
    "sync:catalog": "python3 scripts/install-modules.py --catalog-only",
    "service": "python3 service/server.py",
    "setup:clipboard": "python3 scripts/install-clipboard.py"
  }
}
