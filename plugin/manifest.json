{
  "manifestVersion": 5,
  "id": "xyz.nocturnz.edit",
  "name": { "default": "Nocturnz/Edit" },
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "montage",
      "label": { "default": "Nocturnz/Edit" },
      "minimumSize": { "width": 280, "height": 300 },
      "preferredDockedSize": { "width": 340, "height": 560 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://localhost", "http://localhost:8765"] }
  }
}
